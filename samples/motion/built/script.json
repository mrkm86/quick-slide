    "#flow .n4{left:900px;top:210px}",
    "#flow .n5{left:1200px;top:30px}",
    "#flow .ask{position:absolute;left:840px;top:470px;width:360px;padding:20px 26px;font-size:24px;line-height:1.5}"
   ],
   "html": [
    "<h2 class=\"h2 x f\" data-in=\"0\" data-out=\"2\">頼めば、<em>台本から</em>組み上がる</h2>",
    "<h2 class=\"h2 x f\" data-in=\"2\">直すときは<em>選んで指示</em>するだけ</h2>",
    "<div class=\"body\">",
    "  <div class=\"node n1 card x\" data-in=\"0\"><span class=\"badge\">1</span><b>会話で頼む</b><span class=\"s\">入力欄からも</span></div>",
    "  <div class=\"node n2 card x\" data-in=\"0\" style=\"transition-delay:.1s\"><span class=\"badge\">2</span><b>台本を書く</b><span class=\"s\">場面と拍に分ける</span></div>",
    "  <div class=\"node n3 card x\" data-in=\"0\" style=\"transition-delay:.2s\"><span class=\"badge\">3</span><b>組み立てる</b><span class=\"s\">全部の拍を検査</span></div>",
    "  <div class=\"node n4 card x\" data-in=\"0\" style=\"transition-delay:.3s\"><span class=\"badge\">4</span><b>見て、直す</b><span class=\"s\">ページを選ぶ</span></div>",
    "  <div class=\"node n5 card x\" data-in=\"0\" style=\"transition-delay:.4s\"><span class=\"badge\">5</span><b>書き出す</b><span class=\"s\">HTML と画像</span></div>",
    "  <div class=\"ask card x\" data-in=\"2\"><span class=\"lab\">指示の例</span><br>この図を、もう少し大きく</div>",
    "  <svg class=\"wires\" id=\"flow-w\"></svg>",
    "</div>"
   ],
   "hook": [
    "const nodes = [...document.querySelectorAll(\"#flow .node\")];",
    "const linkNow = () => {",
    "  for (let i = 0; i < 4; i++) x.wire(\"flow-w\", nodes[i], nodes[i + 1]);",
    "  document.querySelectorAll(\"#flow-w .w, #flow-w .dot\").forEach(p => { p.style.animation = \"none\"; p.style.strokeDashoffset = \"0\"; p.style.opacity = \"1\"; });",
    "};",
    "if (b === 1) for (let i = 0; i < 4; i++) x.later(() => x.wire(\"flow-w\", nodes[i], nodes[i + 1]), (x.step ? 300 : 800) + i * 380);",
    "if (b === 2) {",
    "  x.later(linkNow, x.step ? 0 : 800);",
    "  x.later(() => x.hand(\"flow-w\", nodes[3]), x.step ? 350 : 1100);",
    "}"
   ],
   "talk": [
    "作り方は5つの段に分かれます。頼む、台本を書く、組み立てる、見て直す、書き出す、の順です。",
    "線でつなぐと、順番がひと目で追えます。頼むのは会話でも、ホームの入力欄からでもかまいません。",
    "直すときは、ページを選んで指示を書くだけ。大事なところは、こうして手書きの丸で囲めます。"
   ]
  },
